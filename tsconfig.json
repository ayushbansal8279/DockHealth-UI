{
  "compilerOptions": {
    "target": "es2015",
    "module": "commonjs",
    "jsx": "react",
    "sourceMap": true,
    "removeComments": true,
    "noEmit": true,
    "strict": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "baseUrl": "./",
    "paths": {
      "@mui/styled-engine": [
        "./node_modules/@mui/styled-engine-sc"
      ],
      "actions/*": [
        "src/app/actions/*"
      ],
      "context-api/*": [
        "src/app/context-api/*"
      ],
      "api/*": [
        "src/app/api"
      ],
      "restrictions/*": [
        "src/app/restrictions/*"
      ],
      "components/*": [
        "src/app/components/*"
      ],
      "helpers/*": [
        "src/app/helpers/*"
      ],
      "hooks/*": [
        "src/app/hooks/*"
      ],
      "img/*": [
        "src/app/img/*"
      ],
      "reducers/*": [
        "src/app/reducers/*"
      ],
      "views/*": [
        "src/app/views/*"
      ],
      "styles/*": [
        "src/app/styles/*"
      ],
      "selectors/*": [
        "src/app/selectors/*"
      ],
      "types/*": [
        "src/app/types/*"
      ],
    }
  },
  "include": [
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/app/**/*.js",
    "src/app/**/*.jsx",
    "src/app/**/*.png",
    "src/app/**/*.svg"
  ]
}