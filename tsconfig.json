{
  "compilerOptions": {
    "target": "es2015",
    "module": "commonjs",
    "jsx": "react",
    "sourceMap": true,
    "removeComments": true,
    "noEmit": true,
    "strict": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "baseUrl": "./",
    "paths": {
      "actions/*": ["src/app/actions/*"],
      "api/*": ["src/app/api"],
      "components/*": ["src/app/components/*"],
      "helpers/*": ["src/app/helpers/*"],
      "hooks/*": ["src/app/hooks/*"],
      "img/*": ["src/app/img/*"],
      "reducers/*": ["src/app/reducers/*"],
      "views/*": ["src/app/views/*"],
      "styles/*": ["src/app/styles/*"]
    }
  },
  "include": [
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/app/**/*.js",
    "src/app/**/*.jsx",
    "src/app/**/*.png",
    "src/app/**/*.svg"
  ]
}
