{
  "parser": "@typescript-eslint/parser",
  "env": {
    "browser": true,
    "node": true,
    "es6": true,
    "jest/globals": true
  },
  "settings": {
    "import/resolver": {
      "node": {
        "extensions": [".js", ".jsx", ".ts", ".tsx"]
      }
    }
  },
  "extends": [
    "airbnb",
    "airbnb/hooks",
    "plugin:unicorn/recommended",
    "plugin:sonarjs/recommended",
    "prettier",
    "prettier/react",
    "prettier/standard",
    "prettier/@typescript-eslint",
    "plugin:@typescript-eslint/eslint-recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "plugins": [
    "@typescript-eslint",
    "jest",
    "react",
    "react-hooks",
    "unicorn",
    "prettier"
  ],
  "globals": {
    "closeAddForm": true,
    "closeDropdown": true,
    "closePopup": true,
    "enableFoundationAccordionComponent": true,
    "enableFoundationComponent": true,
    "enableFoundationForMultipleComponents": true,
    "enableFoundationForSingleComponent": true,
    "formatDateAndTime": true,
    "openAddForm": true,
    "openDropdown": true,
    "removeRevealComponent": true,
    "renderFoundationComponentsJquery": true,
    "scrollToTop": true,
    "toggleAlert": true,
    "toggleSearch": true,
    "toggleTaskForm": true
  },
  "rules": {
    "prettier/prettier": "error",
    "react/prop-types": "off",
    "react/jsx-props-no-spreading": "off",
    "react/jsx-filename-extension": [
      "error",
      { "extensions": [".jsx", ".tsx"] }
    ],
    "react/state-in-constructor": ["error", "never"],
    "jsx-a11y/click-events-have-key-events": "off",
    "jsx-a11y/no-static-element-interactions": "off",
    "unicorn/filename-case": [
      "error",
      {
        "cases": {
          "pascalCase": true,
          "kebabCase": true
        },
        "ignore": [".conf(ig)?.js(on)?$"]
      }
    ],
    "unicorn/prevent-abbreviations": [
      "error",
      {
        "extendDefaultReplacements": true,
        "replacements": {
          "props": {
            "properties": false
          },
          "conf": {
            "config": false
          }
        }
      }
    ],
    "@typescript-eslint/explicit-function-return-type": "off",
    "@typescript-eslint/no-empty-function": "off",
    "@typescript-eslint/no-unused-vars": "error",
    "no-unused-vars": "off"
  }
}
