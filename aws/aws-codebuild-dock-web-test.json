            {
                "name": "CloudFrontDistributionID",
                "value": "E2JZYLD193ARWQ",
                "type": "PLAINTEXT"
            }
        ]
    }, 
    "serviceRole": "arn:aws:iam::771014269929:role/service-role/codebuild-dock-role"
}