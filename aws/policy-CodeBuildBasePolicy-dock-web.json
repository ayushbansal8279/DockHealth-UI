{
  "Version": "2012-10-17",
  "Statement": [
      {
          "Sid": "CloudWatchLogsPolicy",
          "Effect": "Allow",
          "Resource": [
              "arn:aws:logs:us-east-1:771014269929:log-group:/aws/codebuild/DockWebTest",
              "arn:aws:logs:us-east-1:771014269929:log-group:/aws/codebuild/DockWebTest:*"
          ],
          "Action": [
              "logs:CreateLogGroup",
              "logs:CreateLogStream",
              "logs:PutLogEvents"
          ]
      },
      {
          "Sid": "CodeCommitPolicy",
          "Effect": "Allow",
          "Action": [
              "codecommit:GitPull"
          ],
          "Resource": [
              "*"
          ]
      },
      {
          "Sid": "S3ObjectPolicy",
          "Effect": "Allow",
          "Resource": [
              "arn:aws:s3:::codebuild-dock*"
          ],
          "Action": [
              "s3:PutObject",
              "s3:GetObject",
              "s3:GetObjectVersion",
              "s3:GetBucketAcl",
              "s3:GetBucketLocation"
          ]
      },
      {
          "Sid": "DeployedS3ObjectPolicy",
          "Effect": "Allow",
          "Resource": [
              "arn:aws:s3:::dockdev-v2.childrensaccelerator.com/*"
          ],
          "Action": [
              "s3:PutObject",
              "s3:GetObject",
              "s3:GetObjectVersion",
              "s3:GetBucketAcl",
              "s3:GetBucketLocation",
              "s3:PutObjectAcl"
          ]
      },
      {
          "Sid": "ECRPullPolicy",
          "Effect": "Allow",
          "Action": [
              "ecr:BatchCheckLayerAvailability",
              "ecr:GetDownloadUrlForLayer",
              "ecr:BatchGetImage"
          ],
          "Resource": [
              "*"
          ]
      },
      {
          "Sid": "ECRPushPolicy",
          "Effect": "Allow",
          "Resource": [
              "*"
          ],
          "Action": [
              "ecr:InitiateLayerUpload",
              "ecr:UploadLayerPart",
              "ecr:PutImage",
              "ecr:CompleteLayerUpload"
          ]
      },
      {
          "Sid": "ECRAuthPolicy",
          "Effect": "Allow",
          "Resource": [
              "*"
          ],
          "Action": [
              "ecr:GetAuthorizationToken"
          ]
      },
      {
          "Action": [
              "cloudfront:CreateInvalidation"
          ],
          "Resource": [
              "*"
          ],
          "Effect": "Allow"
      },
      {
          "Action": [
              "ssm:GetParameters"
          ],
          "Resource": [
              "*"
          ],
          "Effect": "Allow"
      }
  ]
}